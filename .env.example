# Configuración de docker compose para ESTA tienda (este clon del repo).
# Copia este archivo a .env en la raíz antes de "docker compose up".
# .env está cubierto por .gitignore (*.env), no se commitea.

# Slug único por tienda. Da nombre al proyecto Compose, a los contenedores
# (<slug>.backend, <slug>.frontend-admin, <slug>.frontend-user), a las redes
# internas y al volumen de uploads. Úsalo distinto en cada clon del repo.
#
#   - Tienda que ya estaba funcional:  STORE_SLUG=duck-hack
#     (conserva el volumen histórico duck-hack.backend-uploads y sus imágenes)
#   - Tienda nueva:  un slug corto y único, p. ej. el dominio sin puntos
#     STORE_SLUG=mx-duck-hack-cloud
STORE_SLUG=duck-hack
