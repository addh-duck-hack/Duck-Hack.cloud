PORT=5000

# --- MongoDB ---
# Conexión única de esta instancia (single-tenant por despliegue: un backend +
# una DB por cliente). El nombre de la variable queda como MONGO_URL_GLOBAL por
# compatibilidad con despliegues existentes; no implica una DB compartida entre
# tiendas.
MONGO_URL_GLOBAL=mongodb://localhost:27017/duckhackdb

# --- Auth/JWT ---
JWT_SECRET=CHANGE_THIS_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_ISSUER=duckhack-cloud-backend
JWT_AUDIENCE=duckhack-cloud-clients
JWT_ACCESS_EXPIRES_IN=1h
JWT_EMAIL_VERIFY_EXPIRES_IN=24h

# --- Email ---
EMAIL_HOST=XXXX
EMAIL_PORT=587
EMAIL_USER=xxxx@duck-hack.com
EMAIL_PASS=xxxxxx

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:82,http://localhost:89
CORS_ALLOW_CREDENTIALS=false

# --- Uploads ---
# En Docker: debe ser /app/uploads — es la ruta que monta el volumen nombrado
# "duck-hack.backend-uploads" en docker-compose.yml, para que las imágenes
# subidas (logos, fotos de equipo/clientes, productos) sobrevivan a
# "docker compose up --build" en vez de perderse con cada contenedor nuevo.
# Fuera de Docker (npm start local): cualquier ruta escribible sirve, ej.
# /tmp/media-uploads; si se deja sin definir, cae en ./uploads del proyecto.
UPLOADS_DIR=/app/uploads

# --- Portainer (métricas de uso del VPS en el panel admin) ---
# Generar en Portainer: My account > API tokens
PORTAINER_URL=https://portainer.server.duck-hack.cloud
PORTAINER_API_TOKEN=
# Opcional: solo si Portainer tiene más de un ambiente/endpoint configurado
PORTAINER_ENDPOINT_ID=
# Capacidad del plan de hosting (Portainer no la conoce, se configura a mano)
SERVER_DISK_TOTAL_GB=200
SERVER_BANDWIDTH_TOTAL_TB=16
