REACT_APP_HOST_SERVICES_URL=http://localhost:5000
# Tenant activo para desarrollo local del admin (opcional)
REACT_APP_TENANT_SLUG=duck-hack
# Header usado por backend para resolver tenant en local/dev
REACT_APP_TENANT_HEADER_NAME=X-Tenant-Slug
# URL del storefront público (link "Ver sitio público" en el sidebar del admin)
REACT_APP_STOREFRONT_URL=https://mx.duck-hack.cloud